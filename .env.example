# Copy to .env (or export these in your shell) -- never commit real values.
# AWS credentials: prefer `aws configure` over env vars, but either works.
AWS_REGION=ap-south-1

# From the Bedrock console/playground's "View API request" for your chosen model.
BEDROCK_MODEL_ID=arn:aws:bedrock:ap-south-1:<your-account-id>:inference-profile/global.anthropic.claude-sonnet-4-5-20250929-v1:0

# S3 bucket that mirrors data/processed/ (see oink/s3.py). Bucket names are global, so pick something unique.
PIGBRAIN_BUCKET=pigbrain-<your-account-id>
